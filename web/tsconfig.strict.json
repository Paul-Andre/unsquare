// tsconfig.strict.json
{
  "extends": "./tsconfig.json", // Inherit all options from the base config
  "compilerOptions": {
    "composite": true, // Required for project references
    "emitDeclarationOnly": true,
    
    /* Stricter Type Checking (The "Strict" Part) */
    "strict": true, // This enables all strict checking flags for TS files
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"], // Include TypeScript and JSON files
  "exclude": ["node_modules"]
}